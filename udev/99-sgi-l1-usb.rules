# SGI L1/L3 system controller USB transport.
#
# The kernel device names are intentionally legacy-compatible.  The stable
# symlinks below give local tooling a predictable place to look.

KERNEL=="sgil1_cs", GROUP="sgil1", MODE="0660", SYMLINK+="sgi-l1/status"
KERNEL=="sgil1_[0-9]*", GROUP="sgil1", MODE="0660", SYMLINK+="sgi-l1/l1-%n"
