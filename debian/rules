#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

DKMS_SRC := debian/sgi-l1-usb-dkms/usr/src/sgi-l1-usb-$(DEB_VERSION)

ifeq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
DEB_CC := cc
else
DEB_CC := $(DEB_HOST_GNU_TYPE)-gcc
endif

ifeq ($(origin CC),default)
CC := $(DEB_CC)
endif
export CC

%:
	dh $@

override_dh_auto_build:
	$(MAKE) -C tools CC="$(CC)"

override_dh_auto_clean:
	$(MAKE) -C tools clean
	$(MAKE) -C module clean || true

override_dh_auto_test:
	:

override_dh_install:
	dh_install
	install -d $(DKMS_SRC)/include $(DKMS_SRC)/module
	sed 's/@VERSION@/$(DEB_VERSION)/g' dkms.conf.in > $(DKMS_SRC)/dkms.conf
	chmod 0644 $(DKMS_SRC)/dkms.conf
	install -m 0644 include/sgi_l1_ioctl.h $(DKMS_SRC)/include/
	install -m 0644 module/Makefile module/sgi_l1_usb.c $(DKMS_SRC)/module/
