#!/bin/sh
set -e

# The old prerm runs before this script. Pre-0.1.57 packages ignored its
# "upgrade" action, so remove their registration while the old source still
# exists. Future upgrades use the version-bound prerm generated by dh_dkms.
case "$1" in
	install|upgrade)
		old_version=${2:-}
		if [ -n "$old_version" ] &&
		   dpkg --compare-versions "$old_version" lt 0.1.57 &&
		   command -v dkms >/dev/null 2>&1; then
			registration=/var/lib/dkms/sgi-l1-usb/$old_version
			if [ -d "$registration" ] &&
			   [ -d "/usr/src/sgi-l1-usb-$old_version" ]; then
				if [ ! -d "$registration/source" ]; then
					dkms add -m sgi-l1-usb -v "$old_version"
				fi
				echo "sgi-l1-usb-dkms: unregistering legacy sgi-l1-usb/$old_version before unpacking"
				if ! dkms remove -m sgi-l1-usb -v "$old_version" --all; then
					echo "sgi-l1-usb-dkms: upgrade stopped before replacing the old source files." >&2
					echo "Resolve the DKMS error above, then retry installing this package." >&2
					exit 1
				fi
			fi
		fi
		;;
esac

#DEBHELPER#

exit 0
